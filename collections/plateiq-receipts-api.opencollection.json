{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Reference accounts receipts API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "receipts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a paginated list of receipts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ottimate.com/v1/receipts",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Api-Key",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "ottimate_company_id",
                "value": "",
                "type": "query",
                "description": "Filter by company ID"
              },
              {
                "name": "ottimate_location_id",
                "value": "",
                "type": "query",
                "description": "Filter by location ID"
              },
              {
                "name": "ottimate_po_id",
                "value": "",
                "type": "query",
                "description": "Filter by purchase order ID"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by receipt status"
              },
              {
                "name": "date_from",
                "value": "",
                "type": "query",
                "description": "Filter by start date (YYYY-MM-DD)"
              },
              {
                "name": "date_to",
                "value": "",
                "type": "query",
                "description": "Filter by end date (YYYY-MM-DD)"
              },
              {
                "name": "expand",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to expand. Supported values: items. When expand=items is used, date_from and date_to must both be provided and within a 30-day window."
              },
              {
                "name": "external_id",
                "value": "",
                "type": "query",
                "description": "Filter by external (ERP) receipt ID"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (default 1)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page (default 20)"
              }
            ]
          },
          "docs": "Returns a paginated list of receipts, filterable by company, location, purchase order, status, and date range."
        },
        {
          "info": {
            "name": "Create a single receipt",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ottimate.com/v1/receipts",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Api-Key",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new receipt linked to an existing purchase order. The `receipt_number` field is required and must be provided by the client"
        },
        {
          "info": {
            "name": "Retrieve a specific receipt by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ottimate.com/v1/receipts/:id",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Api-Key",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the receipt"
              }
            ]
          },
          "docs": "Returns detailed information for a single receipt including all line items."
        },
        {
          "info": {
            "name": "Update an existing receipt",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.ottimate.com/v1/receipts/:id",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Api-Key",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the receipt"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a receipt. Note: `status`, `receipt_number`, `external_id`, and `ottimate_po_id` cannot be changed."
        },
        {
          "info": {
            "name": "Bulk create or update receipts",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ottimate.com/v1/receipts/bulk",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Api-Key",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or updates multiple receipts in a single request. Maximum 100 receipts and 1000 total line items per request. Processing is always asynchronous via Celery and returns a batch tracking ID for polling progress."
        }
      ]
    }
  ],
  "bundled": true
}