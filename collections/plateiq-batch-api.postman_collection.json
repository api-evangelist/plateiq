          "name": "List batches",
          "request": {
            "name": "List batches",
            "description": {
              "content": "Returns a paginated list of batch jobs belonging to the authenticated user, sorted by last modified time descending. Use the `status` filter to narrow results to in-progress or completed batches. Use `date_from` / `date_to` to filter by last modified time range.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "batch"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by batch status. `processing` returns in-progress batches; `completed` returns finished batches."
                },
                {
                  "disabled": false,
                  "key": "date_from",
                  "value": "<dateTime>",
                  "description": "Return only batches last modified at or after this ISO 8601 datetime (e.g. `2024-01-01T00:00:00Z`)."
                },
                {
                  "disabled": false,
                  "key": "date_from_utc",
                  "value": "<dateTime>",
                  "description": "UTC filter. Accepts ISO 8601 with optional Z/offset, or YYYY-MM-DD[ HH:MM:SS] (assumed UTC). Takes precedence over the non-_utc variant."
                },
                {
                  "disabled": false,
                  "key": "date_to",
                  "value": "<dateTime>",
                  "description": "Return only batches last modified at or before this ISO 8601 datetime (e.g. `2024-12-31T23:59:59Z`)."
                },
                {
                  "disabled": false,
                  "key": "date_to_utc",
                  "value": "<dateTime>",
                  "description": "UTC filter. Accepts ISO 8601 with optional Z/offset, or YYYY-MM-DD[ HH:MM:SS] (assumed UTC). Takes precedence over the non-_utc variant."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Number of results per page (default 20)."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number."
