              {
                "name": "X-Api-Key",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the purchase order"
              }
            ]
          },
          "docs": "Returns detailed information for a single purchase order including all line items."
        },
        {
          "info": {
            "name": "Update an existing purchase order",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.ottimate.com/v1/purchase-orders/:id",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Api-Key",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the purchase order"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a purchase order. Note: `status`, `po_number`, `external_id`, `erp_vendor_id`, and `ottimate_location_id` cannot be changed."
        },
        {
          "info": {
            "name": "Bulk create or update purchase orders",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ottimate.com/v1/purchase-orders/bulk",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Api-Key",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or updates multiple purchase orders in a single request. Maximum 100 purchase orders and 1000 total line items per request. Processing is always asynchronous via Celery and returns a batch tracking ID for polling progress."
        }
