      "items": [
        {
          "info": {
            "name": "List catalog entries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ottimate.com/v1/catalog/entries",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Api-Key",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "ottimate_company_id",
                "value": "",
                "type": "query",
                "description": "Filter entries by company ID (required)"
              },
              {
                "name": "erp_vendor_id",
                "value": "",
                "type": "query",
                "description": "Filter entries by vendor name"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search term based on item description or name"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (default: 1)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Items per page (default: 50, max: 100)"
              },
              {
                "name": "expand",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to expand. Options: prices, allowances. When used, returns full CatalogEntryObject instead of CatalogEntryBasicObject."
              },
              {
                "name": "sku",
                "value": "",
                "type": "query",
                "description": "SKU code"
              },
              {
                "name": "upc",
                "value": "",
                "type": "query",
                "description": "UPC code"
              },
              {
                "name": "buying_format",
                "value": "",
                "type": "query",
                "description": "Buying format (e.g. 'CASE', 'EACH'). Pass 'null' to filter entries that have no buying format (NULL or empty)."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Pack size (e.g. '6 CT', '10 LB')"
              },
              {
                "name": "uom",
                "value": "",
                "type": "query",
                "description": "Unit of measure (e.g. 'CASE', 'EACH', 'LB')"
              },
              {
                "name": "price",
                "value": "",
                "type": "query",
                "description": "Price for the pack size"
              },
              {
                "name": "unit_price",
                "value": "",
                "type": "query",
                "description": "Price per individual unit within the pack"
              }
            ]
          },
          "docs": "Returns a paginated list of catalog entries, filterable by company, vendor, and search term."
        },
        {
