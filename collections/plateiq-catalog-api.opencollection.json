                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new catalog entry or updates an existing one if catalog_unique_key matches."
        },
        {
          "info": {
            "name": "Retrieve a catalog entry",
            "type": "http"
