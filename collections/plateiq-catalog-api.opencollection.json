            ],
            "params": [
              {
                "name": "ottimate_company_id",
                "value": "",
                "type": "query",
                "description": "Filter prices by company ID (required)"
              },
              {
                "name": "catalog_entry_id",
                "value": "",
                "type": "query",
                "description": "Filter by catalog entry ID"
              },
              {
                "name": "ottimate_location_id",
                "value": "",
                "type": "query",
                "description": "Filter by location ID"
              },
              {
                "name": "effective_date",
                "value": "",
                "type": "query",
                "description": "Filter prices valid on this date (YYYY-MM-DD)"
              },
              {
                "name": "price_type",
                "value": "",
                "type": "query",
                "description": "Filter by price type"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (default 1)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page (default 20)"
              }
            ]
          },
          "docs": "Returns a paginated list of catalog prices, filterable by company, catalog entry, location, effective date, and price type."
        },
